<main class="page-contact">
  <section class="contact-hero">
    <div class="contact-hero-inner">
      <div class="section-eyebrow" style="color:var(--orange);">Get in Touch</div>
      <h1>Request a Quote Today</h1>
      <p>Tell us your requirements and we'll send a detailed quotation within 24 hours. WhatsApp, email or the form below &mdash; whatever works for you.</p>
    </div>
  </section>

  <section class="contact-content">
    <div class="contact-inner">
      <div class="contact-grid">
        <div class="contact-info-card">
          <h3>Contact Information</h3>
          <div class="contact-item">
            <div class="contact-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <div class="contact-item-label">WhatsApp / Phone</div>
              <div class="contact-item-value"><a href="https://wa.me/8613046035661" target="_blank" rel="noopener">+8613046035661</a></div>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <div class="contact-item-label">Email</div>
              <div class="contact-item-value"><a href="mailto:sales@safelift.de5.net">sales@safelift.de5.net</a></div>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <div class="contact-item-label">Factory Address</div>
              <div class="contact-item-value">Jiyang District, Jinan City,<br>Shandong Province, China</div>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <div>
              <div class="contact-item-label">Business Hours</div>
              <div class="contact-item-value">Mon - Sat: 8:30 - 18:00 (GMT+8)<br>Quote response within 24h</div>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3zM3 9h18M9 21V9"/></svg>
            </div>
            <div>
              <div class="contact-item-label">Trade Terms</div>
              <div class="contact-item-value">EXW / FOB Qingdao / CIF / DDP</div>
            </div>
          </div>
        </div>

        <div class="contact-form-card">
          <h3>Send Us an Inquiry</h3>
          <p>Fill in the form below and our sales team will get back to you within 24 hours with a detailed quotation.</p>
          <form id="contactForm" onsubmit="return handleSubmit(event)">
            <div class="form-row">
              <div class="form-group">
                <label>Your Name <span>*</span></label>
                <input type="text" name="name" placeholder="John Smith" required>
              </div>
              <div class="form-group">
                <label>Company</label>
                <input type="text" name="company" placeholder="ABC Equipment Rental">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Email <span>*</span></label>
                <input type="email" name="email" placeholder="john@company.com" required>
              </div>
              <div class="form-group">
                <label>Country / Region</label>
                <input type="text" name="country" placeholder="United States">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Product of Interest</label>
                <select name="product">
                  <option>10m Electric Scissor Lift</option>
                  <option>16m Articulated Boom Lift</option>
                  <option>10 Ton Mobile Dock Ramp</option>
                  <option>Material Handling Equipment</option>
                  <option>Custom / Other</option>
                </select>
              </div>
              <div class="form-group">
                <label>Quantity</label>
                <input type="text" name="quantity" placeholder="e.g. 2 units">
              </div>
            </div>
            <div class="form-group">
              <label>Message / Requirements <span>*</span></label>
              <textarea name="message" placeholder="Tell us about your project, required specifications, destination port, etc." required></textarea>
            </div>
            <button type="submit" class="form-submit">Send Inquiry</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>
