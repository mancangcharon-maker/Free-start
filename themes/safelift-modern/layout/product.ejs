<main class="page-detail">
  <div class="detail-breadcrumb">
    <div class="detail-breadcrumb-inner">
      <a href="<%= url_for('/') %>">Home</a>
      <span>/</span>
      <a href="<%= url_for('/products/') %>">Products</a>
      <span>/</span>
      <span><%= page.title %></span>
    </div>
  </div>

  <%
    let pageCat = '';
    if (page.category) {
      pageCat = page.category;
    } else if (page.categories && page.categories.length && page.categories.first) {
      const firstCat = page.categories.first();
      pageCat = (firstCat && firstCat.name) ? firstCat.name : '';
    }
  %>

  <section class="detail-main">
    <div class="detail-inner">
      <div class="detail-grid">
        <div class="detail-gallery">
          <span class="detail-gallery-badge"><%= page.badge || 'CE Certified' %></span>
          <img src="<%= page.cover || page.image %>" alt="<%= page.title %>" loading="lazy">
        </div>
        <div class="detail-info">
          <div class="product-cat"><%= pageCat %></div>
          <h1><%= page.title %></h1>
          <div class="detail-model">Model: <%= page.model || page.title %></div>
          <div class="detail-price-box">
            <div>
              <div class="detail-price-label">Reference Price (EXW)</div>
              <div class="detail-price-value"><%= page.price || 'Contact for Quotation' %></div>
              <div class="detail-price-note">Final price depends on configuration &amp; quantity</div>
            </div>
          </div>
          <p class="detail-desc"><%- page.description || page.excerpt || strip_html(page.content).substring(0, 280) %></p>

          <% if (page.features && page.features.length) { %>
          <ul class="detail-features">
            <% page.features.forEach(function(f) { %>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
              <%- f %>
            </li>
            <% }); %>
          </ul>
          <% } %>

          <div class="detail-actions">
            <a href="<%= url_for('/contact/') %>" class="btn btn-primary">
              Request Quote
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="<%= url_for('/products/') %>" class="btn btn-outline" style="color:var(--charcoal);border-color:var(--gray-200);">Back to Products</a>
          </div>
        </div>
      </div>

      <% if (page.specs_table && page.specs_table.length) { %>
      <div class="spec-section">
        <h2>Technical Specifications</h2>
        <table class="spec-table">
          <% page.specs_table.forEach(function(row) { %>
          <tr>
            <th><%= row[0] %></th>
            <td><%- row[1] %></td>
          </tr>
          <% }); %>
        </table>
      </div>
      <% } %>

      <% if (page.applications && page.applications.length) { %>
      <div class="spec-section">
        <h2>Typical Applications</h2>
        <div class="app-grid">
          <% page.applications.forEach(function(a) { %>
          <div class="app-card">
            <div class="app-icon">
              <%- a.icon || '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>' %>
            </div>
            <h4><%= a.name %></h4>
            <p><%- a.desc %></p>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (page.content && page.content.length) { %>
      <div class="spec-section">
        <h2>Product Description</h2>
        <article class="post-content" style="font-size:15px;color:var(--gray-600);line-height:1.8;">
          <%- page.content %>
        </article>
      </div>
      <% } %>
    </div>
  </section>
</main>
