<main class="page-home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-grid"></div>
    <div class="hero-content">
      <div class="hero-tag">China Manufacturer &amp; Exporter Since 2008</div>
      <h1>Reliable Aerial Work <em>Platforms</em> for Global Business</h1>
      <p>CE-certified scissor lifts, boom lifts, dock ramps and material handling equipment. Factory-direct pricing, 15+ years export experience, shipping to 80+ countries worldwide.</p>
      <div class="hero-buttons">
        <a href="<%= url_for('/products/') %>" class="btn btn-primary">
          View Products
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="<%= url_for('/contact/') %>" class="btn btn-outline">Request Quote</a>
      </div>
    </div>
    <div class="hero-stats">
      <div class="hero-stats-inner">
        <div class="stat-item">
          <div class="stat-num">15+</div>
          <div class="stat-label">Years Export Experience</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">80+</div>
          <div class="stat-label">Countries Served</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">5000+</div>
          <div class="stat-label">Units Shipped Yearly</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">CE</div>
          <div class="stat-label">EU Certified</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Categories -->
  <section class="section categories">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">Our Product Lines</div>
        <h2 class="section-title">Equipment Built for Heavy-Duty Work</h2>
        <p class="section-desc">Four core product categories covering aerial work, loading and material handling needs across construction, warehousing and logistics industries.</p>
      </div>
      <div class="cat-grid">
        <a href="<%= url_for('/products/') %>#scissor" class="cat-card">
          <div class="cat-img">
            <span class="cat-badge">Best Seller</span>
            <img src="https://aka.doubaocdn.com/s/wqC82QAoZz" alt="Electric Scissor Lift" loading="lazy">
          </div>
          <div class="cat-body">
            <h3>Scissor Lifts</h3>
            <p>Self-propelled electric scissor lifts, 6m-16m working height, ideal for indoor maintenance and installation.</p>
            <span class="cat-link">Explore Models
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
        <a href="<%= url_for('/products/') %>#boom" class="cat-card">
          <div class="cat-img">
            <span class="cat-badge">Outdoor</span>
            <img src="https://aka.doubaocdn.com/s/KG3Tb2OUjd" alt="Articulated Boom Lift" loading="lazy">
          </div>
          <div class="cat-body">
            <h3>Boom Lifts</h3>
            <p>Articulated and telescopic boom lifts, 14m-44m reach, diesel and electric options for outdoor construction.</p>
            <span class="cat-link">Explore Models
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
        <a href="<%= url_for('/products/') %>#dock" class="cat-card">
          <div class="cat-img">
            <span class="cat-badge">Logistics</span>
            <img src="https://aka.doubaocdn.com/s/hbS5B2DGaQ" alt="Loading Dock Ramp" loading="lazy">
          </div>
          <div class="cat-body">
            <h3>Dock Ramps</h3>
            <p>Mobile and fixed loading dock ramps, 6-15 ton capacity, bridge forklift and container trucks at any warehouse.</p>
            <span class="cat-link">Explore Models
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
        <a href="<%= url_for('/products/') %>#material" class="cat-card">
          <div class="cat-img">
            <span class="cat-badge">Warehouse</span>
            <img src="https://aka.doubaocdn.com/s/hbS5B2DGaQ" alt="Pallet Truck" loading="lazy" style="object-fit:cover;">
          </div>
          <div class="cat-body">
            <h3>Material Handling</h3>
            <p>Manual and electric pallet trucks, stackers and order pickers, built for efficient warehouse floor operations.</p>
            <span class="cat-link">Explore Models
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">Why SafeLift</div>
        <h2 class="section-title">Built to Work, Priced to Compete</h2>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3>Factory Direct</h3>
          <p>No middlemen. We manufacture every unit in our own 20,000 m&sup2; facility in Shandong, passing savings directly to you.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3>CE Certified</h3>
          <p>Full-machine CE certification by TUV, not just component certificates. Every model passes EU safety standards for hassle-free customs clearance.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3>Global Shipping</h3>
          <p>EXW, FOB, CIF and DDP terms available. We handle documentation, container loading and shipping to 80+ countries with reliable forwarders.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3>Custom Solutions</h3>
          <p>Need a non-standard height, capacity or platform size? Our engineering team designs custom lifts for unique project requirements.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3>Fast Lead Time</h3>
          <p>Standard models ship within 10-15 days. Large stock of core components ensures quick turnaround even for bulk orders of 20+ units.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </div>
          <h3>After-Sales Support</h3>
          <p>2-year warranty on main structure, 1-year on electrical components. English manual, video guides and spare parts kit included with every order.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta-banner">
    <div class="cta-inner">
      <div class="cta-text">
        <h2>Ready to Source Directly from Factory?</h2>
        <p>Get a detailed quotation within 24 hours. No obligation, no middleman markup.</p>
      </div>
      <div class="cta-buttons">
        <a href="<%= url_for('/contact/') %>" class="btn btn-primary">Get Free Quote</a>
        <a href="<%= url_for('/products/') %>" class="btn btn-outline">Browse Catalog</a>
      </div>
    </div>
  </section>
</main>
