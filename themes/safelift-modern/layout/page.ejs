<main class="page-default">
  <section class="page-default-hero">
    <div class="page-default-inner">
      <h1><%= page.title %></h1>
      <% if (page.description) { %>
      <p><%= page.description %></p>
      <% } %>
    </div>
  </section>
  <section class="page-default-content">
    <div class="page-default-inner">
      <article class="post-content">
        <%- page.content %>
      </article>
    </div>
  </section>
</main>

<style>
.page-default-hero {
  background: var(--charcoal);
  padding: 60px 24px;
  position: relative;
  overflow: hidden;
}
.page-default-hero::before {
  content: '';
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(255,107,0,0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,107,0,0.06) 1px, transparent 1px);
  background-size: 50px 50px;
}
.page-default-inner { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; }
.page-default-hero h1 {
  font-family: var(--font-display);
  font-size: clamp(32px, 5vw, 52px);
  font-weight: 700;
  color: var(--white);
  text-transform: uppercase;
  margin-bottom: 12px;
}
.page-default-hero p {
  font-size: 16px;
  color: var(--gray-400);
  max-width: 600px;
}
.page-default-content { padding: 60px 24px; }
.post-content { font-size: 15px; color: var(--gray-600); line-height: 1.8; }
.post-content h2 {
  font-family: var(--font-display);
  font-size: 28px; font-weight: 700;
  text-transform: uppercase;
  margin: 32px 0 16px;
  color: var(--charcoal);
  padding-bottom: 12px;
  border-bottom: 3px solid var(--orange);
  display: inline-block;
}
.post-content p { margin-bottom: 16px; }
.post-content ul, .post-content ol { padding-left: 24px; margin-bottom: 16px; }
.post-content li { margin-bottom: 8px; }
.post-content a { color: var(--orange); }
.post-content a:hover { text-decoration: underline; }
.post-content img { max-width: 100%; height: auto; margin: 16px 0; }
.post-content table { width: 100%; border-collapse: collapse; margin: 20px 0; }
.post-content th, .post-content td { padding: 12px 16px; border-bottom: 1px solid var(--gray-200); text-align: left; }
.post-content th { background: var(--charcoal); color: var(--white); font-family: var(--font-display); text-transform: uppercase; font-size: 13px; }
</style>
