<main class="page-post">
  <article class="post-article">
    <header class="post-article-header">
      <h1><%= page.title %></h1>
      <% if (page.date) { %>
      <div class="post-article-meta">
        <time datetime="<%= page.date.toISOString() %>"><%= page.date.format('YYYY-MM-DD') %></time>
      </div>
      <% } %>
    </header>
    <div class="post-article-content">
      <%- page.content %>
    </div>
  </article>
</main>

<style>
.post-article { max-width: 880px; margin: 0 auto; padding: 60px 24px; }
.post-article-header { margin-bottom: 32px; padding-bottom: 20px; border-bottom: 1px solid var(--gray-200); }
.post-article-header h1 {
  font-family: var(--font-display);
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 700;
  text-transform: uppercase;
  color: var(--charcoal);
  line-height: 1.2;
  margin-bottom: 12px;
}
.post-article-meta { font-size: 13px; color: var(--gray-600); }
.post-article-content { font-size: 15px; color: var(--gray-600); line-height: 1.85; }
.post-article-content h2 {
  font-family: var(--font-display);
  font-size: 26px; font-weight: 700;
  text-transform: uppercase;
  margin: 32px 0 16px;
  color: var(--charcoal);
  padding-bottom: 8px;
  border-bottom: 2px solid var(--orange);
  display: inline-block;
}
.post-article-content h3 {
  font-family: var(--font-display);
  font-size: 20px; font-weight: 600;
  text-transform: uppercase;
  margin: 24px 0 12px;
  color: var(--charcoal);
}
.post-article-content p { margin-bottom: 16px; }
.post-article-content a { color: var(--orange); }
.post-article-content ul, .post-article-content ol { padding-left: 24px; margin-bottom: 16px; }
.post-article-content li { margin-bottom: 8px; }
.post-article-content img { max-width: 100%; height: auto; margin: 20px 0; border: 1px solid var(--gray-200); }
.post-article-content blockquote {
  border-left: 3px solid var(--orange);
  background: var(--gray-50);
  padding: 16px 20px;
  margin: 20px 0;
  color: var(--charcoal);
}
.post-article-content pre {
  background: var(--charcoal);
  color: var(--gray-200);
  padding: 16px;
  overflow-x: auto;
  font-size: 13px;
  margin: 16px 0;
}
.post-article-content code {
  background: var(--gray-100);
  color: var(--orange);
  padding: 2px 6px;
  font-size: 13px;
}
.post-article-content pre code { background: transparent; color: inherit; padding: 0; }
.post-article-content table { width: 100%; border-collapse: collapse; margin: 20px 0; }
.post-article-content th, .post-article-content td { padding: 12px 16px; border-bottom: 1px solid var(--gray-200); text-align: left; }
.post-article-content th { background: var(--charcoal); color: var(--white); font-family: var(--font-display); text-transform: uppercase; font-size: 13px; }
</style>
